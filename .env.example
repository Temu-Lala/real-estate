# Next.js frontend configuration. Copy to .env.local.
# Base URL of the Go API (api/). Defaults to http://localhost:8080.
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Listing analytics (optional) ---
# Private Go address the server-side /api/track route forwards events to.
# Falls back to NEXT_PUBLIC_API_URL when unset (only needed if they differ).
# API_INTERNAL_URL=http://localhost:8080
# Salt for the anonymous visitor token (unique-visitor counts). Long random string.
# ANALYTICS_SALT=
# Shared secret required by the Go /api/v1/track endpoint. Must match api/.env.
# TRACKING_SECRET=
