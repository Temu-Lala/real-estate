# Go API configuration (api/). Copy to api/.env and fill in real values.
# Required. Neon or any PostgreSQL connection string.
DATABASE_URL=postgres://user:password@host/database?sslmode=require

# Directory for uploaded property images. Defaults to ./data/uploads.
UPLOAD_DIR=./data/uploads

# HTTP port. Defaults to 8080.
PORT=8080

# Admin credentials (compared constant-time at POST /api/v1/admin/login).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secret used to HMAC-sign the admin session cookie. Use a long random string.
ADMIN_SESSION_SECRET=

# Set to "true" in production so the session cookie is flagged Secure.
COOKIE_SECURE=false

# --- Listing analytics (optional) ---
# Shared secret for POST /api/v1/track. When set, the endpoint only accepts
# events that carry a matching X-Tracking-Secret header (sent by the Next
# /api/track route). Must match TRACKING_SECRET in the frontend .env.local.
TRACKING_SECRET=
